{
  "name": "turbo-type-racer",
  "version": "1.0.0",
  "description": "Cyberpunk car racing typing game with AI opponents and WebRTC peer-to-peer multiplayer.",
  "main": "main.js",
  "author": "Dipayan Bhanja",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
